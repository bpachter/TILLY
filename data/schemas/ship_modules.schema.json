{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilly.dev/schemas/ship_modules.schema.json",
  "title": "Ship Modules",
  "type": "object",
  "required": ["schema_version", "modules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "slot_type", "power_draw", "durability", "tags"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "slot_type": { "enum": ["utility", "defense", "offense", "science", "life_support"] },
          "power_draw": { "type": "integer", "minimum": 0 },
          "durability": { "type": "integer", "minimum": 1 },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
