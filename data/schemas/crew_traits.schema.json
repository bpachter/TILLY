{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilly.dev/schemas/crew_traits.schema.json",
  "title": "Crew Traits",
  "type": "object",
  "required": ["schema_version", "traits"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "traits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "modifiers"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "enum": ["operational", "social", "crisis", "curiosity"] },
          "hidden": { "type": "boolean", "default": false },
          "modifiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["target", "operation", "value"],
              "additionalProperties": false,
              "properties": {
                "target": { "type": "string", "minLength": 1 },
                "operation": { "enum": ["add", "multiply", "set"] },
                "value": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
