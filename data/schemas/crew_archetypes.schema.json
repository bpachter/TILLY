{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilly.dev/schemas/crew_archetypes.schema.json",
  "title": "Crew Archetypes",
  "type": "object",
  "required": ["schema_version", "archetypes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "base_stats", "trait_pool"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "role": { "enum": ["pilot", "engineer", "scientist", "security", "medic", "diplomat"] },
          "base_stats": {
            "type": "object",
            "required": ["repair_speed", "combat_focus", "scan_precision", "stress_tolerance"],
            "additionalProperties": false,
            "properties": {
              "repair_speed": { "type": "number", "minimum": 0 },
              "combat_focus": { "type": "number", "minimum": 0 },
              "scan_precision": { "type": "number", "minimum": 0 },
              "stress_tolerance": { "type": "number", "minimum": 0 }
            }
          },
          "trait_pool": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
          }
        }
      }
    }
  }
}
