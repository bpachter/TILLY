{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilly.dev/schemas/enemy_templates.schema.json",
  "title": "Enemy Templates",
  "type": "object",
  "required": ["schema_version", "enemies"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "enemies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "faction", "hull", "subsystems", "behavior_profile"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "faction": { "enum": ["alien_swarm", "rogue_ai", "hybrid_collective", "pirate_scavengers"] },
          "hull": { "type": "number", "minimum": 1 },
          "subsystems": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["engines", "shields", "life_support", "sensors", "weapons", "lab"] }
          },
          "behavior_profile": {
            "type": "object",
            "required": ["aggression", "boarding_bias", "targeting_bias"],
            "additionalProperties": false,
            "properties": {
              "aggression": { "type": "number", "minimum": 0, "maximum": 1 },
              "boarding_bias": { "type": "number", "minimum": 0, "maximum": 1 },
              "targeting_bias": { "enum": ["weapons", "engines", "life_support", "balanced"] }
            }
          }
        }
      }
    }
  }
}
